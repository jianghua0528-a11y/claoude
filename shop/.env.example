# 服装店 环境变量 —— Railway 在 Variables 里设; 本地复制成 .env
SHOP_BOT_TOKEN=              # @BotFather 新建一个机器人拿 token (别和 C组机器人共用)
SHOP_ADMIN_IDS=              # 店家 Telegram user_id, 逗号分隔 (给机器人发 /admin 可看到自己的 ID)
SHOP_ADMIN_PASSWORD=         # 网页后台登录密码 (必填)
SHOP_DATABASE_URL=           # 不填就用 DATABASE_URL; 都没有则本地 SQLite
SHOP_NAME=我的服装店
SHOP_CONTACT=@your_username  # 客服联系方式
SHOP_ADMIN_URL=              # 后台网址, /admin 里显示
SHOP_CURRENCY=RM
SHIPPING_FEE=8               # 运费
FREE_SHIPPING_OVER=150       # 满多少包邮, 0 = 不包邮
UNPAID_EXPIRE_HOURS=24       # 下单多少小时不付款自动取消(退库存)
LOW_STOCK=2                  # 库存 ≤ 这个数在看板提醒
PAYMENT_INFO=Maybank 1234 5678 9012\n户名 XXX\nTNG: 012-3456789   # 收款信息, \n 换行
PAYMENT_QR_URL=              # 收款码图片网址 (可选, DuitNow/TNG 二维码)
